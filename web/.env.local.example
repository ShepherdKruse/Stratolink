# Mapbox Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: For server-side operations
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin: launchpad + one-click payload registration (/admin/register-payload)
ADMIN_ACTIVATION_KEY=generate_a_long_random_secret

# The Things Stack (TTN) — used by POST /api/admin/register-payload to create devices
# Cluster URL (no trailing path): community e.g. https://nam1.cloud.thethings.network
TTN_STACK_HOST=https://nam1.cloud.thethings.network
TTN_APPLICATION_ID=your_ttn_application_id
# API key with right to register devices in that application (NNSXS…)
TTN_API_KEY=
# Default Join EUI (16 hex) = firmware LORAWAN_APP_EUI when you omit it in the form
TTN_JOIN_EUI=0000000000000000
# Optional; default US_902_928_FSB2. EU example: EU_863_870_TTN
# TTN_FREQUENCY_PLAN_ID=US_902_928_FSB2
