# Mapbox Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_access_token_here

# Public site URL for launch QR links (production). Fallback: VERCEL_URL on Vercel, localhost in dev.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Required for webhooks, activation, admin registration (server-side only — never NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Admin: /admin/register-payload, /admin/launch-kit, POST /api/admin/register-payload
ADMIN_ACTIVATION_KEY=generate_a_long_random_secret

# The Things Stack — register-payload creates OTAA devices in this application
TTN_STACK_HOST=https://nam1.cloud.thethings.network
TTN_APPLICATION_ID=your_ttn_application_id
TTN_API_KEY=
# Default Join EUI (16 hex) = LORAWAN_APP_EUI in firmware when omitted in the form
TTN_JOIN_EUI=0000000000000000
# Optional; default US_902_928_FSB2
# TTN_FREQUENCY_PLAN_ID=US_902_928_FSB2

# Email (Resend) — website contact form + launch signup notifications
# Get API key: https://resend.com/api-keys
# After adding stratolink.org in Resend → Domains, set FROM to a verified address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Stratolink <notifications@stratolink.org>
# Comma-separated inboxes (Google Workspace aliases or groups)
CONTACT_FORM_TO=contact@stratolink.org,info@stratolink.org
LAUNCH_SIGNUP_NOTIFY_EMAIL=contact@stratolink.org
