#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to secrets.h and fill in your TTN/LoRaWAN values.
// secrets.h is gitignored. DO NOT COMMIT REAL KEYS.
//
// Multi-region OTAA: TTN community network enforces globally-unique
// DevEUIs across all clusters (nam1, eu1).  To get telemetry in
// multiple LoRaWAN regions during a circumnavigation you need to
// register a SEPARATE device on TTN for each frequency plan and flash
// all the resulting (DevEUI, AppKey) pairs here.  Region selection
// happens at runtime via the GPS-driven geofence — see
// src/region_manager.cpp and src/lorawan.cpp lorawan_set_region.
//
// Empty string for any region disables joins in that region (the
// firmware still respects geofence spectrum rules, just won't transmit
// join requests).  Typical jet-stream northern-hemisphere circumnav
// only crosses US915 + EU868 + AS923 — AU915 can be left empty.
//
// JoinEUI is shared across regions (TTN convention = 0000000000000000).

// === Legacy single-EUI defaults — used as fallback for any region
//     below whose LORAWAN_*_<REGION> is left empty.  Set to your US915
//     credentials if you're flying primarily over US territory. ===
#define LORAWAN_DEV_EUI ""
#define LORAWAN_APP_EUI "0000000000000000"
#define LORAWAN_APP_KEY ""

// === Per-region overrides ===
// US915: registered on TTN nam1 cluster
#define LORAWAN_DEV_EUI_US ""
#define LORAWAN_APP_KEY_US ""

// EU868: registered on TTN eu1 cluster
#define LORAWAN_DEV_EUI_EU ""
#define LORAWAN_APP_KEY_EU ""

// AS923: registered on TTN eu1 cluster (different DevEUI from EU868)
#define LORAWAN_DEV_EUI_AS ""
#define LORAWAN_APP_KEY_AS ""

// AU915: registered on TTN nam1 cluster (different DevEUI from US915).
// Leave empty if circumnav doesn't transit Australia/NZ.
#define LORAWAN_DEV_EUI_AU ""
#define LORAWAN_APP_KEY_AU ""

// === StratoLink fleet B2B command authentication ===
// 128-bit AES-CMAC key (32 hex chars), shared by fleet nodes. Every B2B wire-v3
// frame type (crumb, command, and ACK) fails closed while this is empty.
#define B2B_FLEET_KEY ""

#endif
